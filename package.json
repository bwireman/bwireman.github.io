{
  "name": "bwireman.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "scripts": {
    "dev": "rm -f index.html && vite",
    "build": "./scripts/build.sh",
    "preview": "vite preview",
    "format": "prettier --plugin-search-dir . --write '{public,src}/**/*.{css,html,ts,js,svelte}'",
    "lint": "eslint --fix --quiet src",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "playwright test",
    "prepare": "husky",
    "dl-resume": "./scripts/dl-resume.sh",
    "update": "yarn up"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSpacing": false,
    "singleQuote": false,
    "svelteSortOrder": "options-scripts-markup-styles",
    "trailingComma": "none",
    "useTabs": false,
    "tabWidth": 2,
    "semi": false,
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gleam-lang/highlight.js-gleam": "^1.5.0",
    "@playwright/test": "^1.64.1",
    "@svelte-plugins/viewable": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "bulma": "^1.0.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.107.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-highlight": "^7.23.1",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "ua-parser-js": "^2.0.10"
  }
}
